<Window x:Class="MPQTikTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MPQ Tik Tool · 通用 War3 地图资源浏览器" Height="860" Width="1400" MinHeight="620" MinWidth="1000"
        Background="#FF171A20" Foreground="#FFE8ECF2" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF20242C" Padding="12,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenButton" Content="打开地图" Padding="16,7" Margin="0,0,6,0" Click="OpenMap_Click"/>
                        <Button x:Name="ListFileButton" Content="加载文件名库" Padding="12,7" Margin="0,0,6,0" Click="LoadListFile_Click"
                                ToolTip="导入外部 listfile，按哈希匹配恢复资源原名"/>
                        <Button x:Name="AnalyzeButton" Content="分析资源" Padding="12,7" Margin="0,0,6,0" Click="Analyze_Click"
                                ToolTip="按内容识别所有资源类型，并从地图内容中恢复文件名"/>
                        <Button x:Name="DeepAnalyzeButton" Content="深度恢复文件名" Padding="12,7" Margin="0,0,6,0" Click="DeepAnalyze_Click"
                                ToolTip="扩大扫描范围，尽可能恢复更多原始文件名"/>
                        <Button x:Name="ExportSelectedButton" Content="导出选中" Padding="12,7" Margin="0,0,6,0" Click="ExportSelected_Click"/>
                        <Button x:Name="ExportFilteredButton" Content="导出筛选结果" Padding="12,7" Margin="0,0,6,0" Click="ExportFiltered_Click"/>
                        <Button x:Name="ExportAllButton" Content="导出全部资源" Padding="14,7" Click="ExportAll_Click"/>
                        <Button x:Name="RestoreButton" Content="还原地图" Padding="14,7" Margin="8,0,0,0" Click="RestoreMap_Click"
                                ToolTip="修复被保护的 hash 表 locale、写回 (listfile)，生成 World Editor 可打开的地图与还原工程包"/>
                        <Button x:Name="CancelButton" Content="取消" Padding="12,7" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="MapPathText" Text="未打开地图" VerticalAlignment="Center" Margin="18,0,0,0"
                               Foreground="#FF9BA7B8" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBox x:Name="SearchBox" Width="320" Padding="7" VerticalContentAlignment="Center"
                             ToolTip="搜索文件名、扩展名、类型或块索引" TextChanged="SearchBox_TextChanged"/>
                    <ComboBox x:Name="CategoryBox" Width="150" Margin="8,0,0,0" Padding="6"
                              SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="全部类型" IsSelected="True"/>
                        <ComboBoxItem Content="图片"/><ComboBoxItem Content="模型"/><ComboBoxItem Content="音频"/>
                        <ComboBoxItem Content="文本/脚本"/><ComboBoxItem Content="地图/物编数据"/><ComboBoxItem Content="其他"/>
                    </ComboBox>
                    <ComboBox x:Name="SourceBox" Width="120" Margin="8,0,0,0" Padding="6" SelectionChanged="FilterChanged"
                              ToolTip="按名称来源筛选：原名来自哈希匹配，推断名来自内容嗅探">
                        <ComboBoxItem Content="全部来源" IsSelected="True"/>
                        <ComboBoxItem Content="原名"/><ComboBoxItem Content="推断"/>
                    </ComboBox>
                    <TextBlock x:Name="CountText" Margin="14,0" VerticalAlignment="Center" Foreground="#FF9BA7B8"/>
                    <ProgressBar x:Name="OperationProgress" Width="220" Height="14" Margin="0,0,8,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Foreground="#FF9BA7B8" MinWidth="150"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#FF20242C" Foreground="#FFB9C2D0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="就绪"/></StatusBarItem>
        </StatusBar>
        <TabControl Margin="12" Background="#FF171A20" BorderBrush="#FF343B48"><TabItem Header="资源浏览"><Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="EntriesGrid" Grid.Column="0" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Extended" SelectionChanged="EntriesGrid_SelectionChanged"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      Background="#FF20242C" Foreground="#FFE8ECF2" RowBackground="#FF20242C"
                      AlternatingRowBackground="#FF262C36" BorderBrush="#FF343B48" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="资源名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="来源" Binding="{Binding NameSource}" Width="55"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="95"/>
                    <DataGridTextColumn Header="格式" Binding="{Binding KindName}" Width="95"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="85"/>
                    <DataGridTextColumn Header="块" Binding="{Binding BlockIndex}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Margin="10,0,0,0" Background="#FF20242C" BorderBrush="#FF343B48" BorderThickness="1" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="PreviewName" Text="资源预览" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewInfo" Foreground="#FF9BA7B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <ComboBox x:Name="PreviewModeBox" Width="110" Margin="0,0,6,0" Padding="5" SelectionChanged="PreviewMode_Changed">
                                <ComboBoxItem Content="自动" IsSelected="True"/>
                                <ComboBoxItem Content="文本"/>
                                <ComboBoxItem Content="十六进制"/>
                            </ComboBox>
                            <Button Content="导出此资源" Padding="10,5" Click="ExportSelected_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <TextBox x:Name="TextPreview" Visibility="Collapsed" IsReadOnly="True" TextWrapping="NoWrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#FF15181E" Foreground="#FFD6E0ED" BorderThickness="0" FontFamily="Consolas"/>
                        <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImagePreview" Stretch="Uniform" />
                        </ScrollViewer>
                        <StackPanel x:Name="AudioPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Volume="0.8" Height="1" Width="1" Opacity="0" IsHitTestVisible="False"/>
                            <TextBlock Text="音频资源" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="播放" Padding="16,8" Margin="4" Click="AudioPlay_Click"/>
                                <Button Content="暂停" Padding="16,8" Margin="4" Click="AudioPause_Click"/>
                                <Button Content="停止" Padding="16,8" Margin="4" Click="AudioStop_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AudioStatus" Foreground="#FF9BA7B8" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="FallbackPreview" Text="选择左侧资源以查看预览" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF9BA7B8" FontSize="15"/>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid></TabItem>
        <TabItem Header="MPQ 结构"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
            <TextBlock Text="MPQ 容器结构检查" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="当前传统 Hash/Block Table 解析已有基础；v4 HET/BET、完整压缩掩码、CRC 全量验证、64 位偏移和大文件重建尚未完成。后续此页展示真实 Header、表项、块布局、扇区表及校验状态。" TextWrapping="Wrap" Foreground="#FFB9C2D0"/>
            <GroupBox Header="底层能力验收" Margin="0,16,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="MPQ v1 / v2 / v3 / v4 与 HET/BET"/>
                    <TextBlock Text="Hash Table / Block Table / 扩展表"/>
                    <TextBlock Text="扇区偏移表、加密、压缩掩码、CRC"/>
                    <TextBlock Text="32/64 位偏移、大文件、匿名 Block 原始数据"/>
                    <TextBlock Text="状态：按路线图逐项实现并由测试验证" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="地图结构"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
            <TextBlock Text="地图结构解析" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <UniformGrid Columns="2">
                <GroupBox Header="地图与场景数据" Margin="4" Padding="10"><StackPanel>
                    <TextBlock Text="W3I · 地图信息"/><TextBlock Text="W3E · 地形"/><TextBlock Text="WPM · 寻路图"/><TextBlock Text="DOO · 装饰物"/><TextBlock Text="SHD · 阴影图"/>
                    <TextBlock Text="状态：解析器接入待实现" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
                </StackPanel></GroupBox>
                <GroupBox Header="物编与触发器" Margin="4" Padding="10"><StackPanel>
                    <TextBlock Text="W3U / W3T / W3A / W3B / W3D / W3Q"/>
                    <TextBlock Text="WTG / WCT / WTS"/>
                    <TextBlock Text="对象 ID、字段修改、函数、变量和字符串引用"/>
                    <TextBlock Text="状态：结构化解析待实现" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
                </StackPanel></GroupBox>
            </UniformGrid>
            <GroupBox Header="资源依赖关系" Margin="4,12,4,4" Padding="10">
                <TextBlock Text="计划展示模型到纹理、物编到对象、触发器到函数/变量/字符串，以及场景到资源文件的引用关系。缺失引用将保留为问题项。" TextWrapping="Wrap"/>
            </GroupBox>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="工程重建"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
            <TextBlock Text="地图工程重建与校验" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="目标输出：可编辑地图目录、独立资源工程、结构化地图模型、原始脚本与完整恢复报告。" TextWrapping="Wrap" Foreground="#FFB9C2D0"/>
            <GroupBox Header="重建流水线" Margin="0,16,0,0" Padding="12"><StackPanel>
                <TextBlock Text="1. 名称证据确认 → 2. 资源解密/解压 → 3. 目录与依赖重建 → 4. Hash/Block Table 重建 → 5. 重新打包 → 6. SHA-256 逐项比对"/>
                <TextBlock Text="当前已有基础导出和有限地图修复；完整工程重建、扩展表重建及逐项重打包校验尚未完成。" Foreground="#FFFFC66D" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel></GroupBox>
            <GroupBox Header="完整性报告" Margin="0,12,0,0" Padding="12">
                <TextBlock Text="分别统计原名确认、名称推断、匿名块、密文保留、解压失败、CRC 失败、未知格式、解析失败、缺失引用、不可逆/受保护数据，以及每个输出文件的 SHA-256。" TextWrapping="Wrap"/>
            </GroupBox>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="逆向分析"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
            <TextBlock Text="脚本与私有容器分析" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <UniformGrid Columns="2">
                <GroupBox Header="JASS 分析" Margin="4" Padding="10"><StackPanel>
                    <TextBlock Text="源码识别 / 词法语法分析"/><TextBlock Text="函数、全局变量、调用关系"/><TextBlock Text="反编译结果与原始字节并存"/>
                    <TextBlock Text="状态：待实现" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
                </StackPanel></GroupBox>
                <GroupBox Header="Lua 分析" Margin="4" Padding="10"><StackPanel>
                    <TextBlock Text="源码与字节码版本检测"/><TextBlock Text="指令反汇编 / 常量与字符串提取"/><TextBlock Text="匹配 VM 版本后尝试反编译"/>
                    <TextBlock Text="状态：待实现" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
                </StackPanel></GroupBox>
                <GroupBox Header="平台插件与自定义容器" Margin="4" Padding="10"><StackPanel>
                    <TextBlock Text="魔数、长度、版本、嵌套结构探测"/><TextBlock Text="熵与重复块特征分析"/><TextBlock Text="已知算法 / 疑似变换 / 未知数据分类"/>
                    <TextBlock Text="状态：待实现" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
                </StackPanel></GroupBox>
                <GroupBox Header="证据与结论" Margin="4" Padding="10"><StackPanel>
                    <TextBlock Text="保留原始字节与 SHA-256"/><TextBlock Text="记录分析假设、置信度和复现步骤"/><TextBlock Text="不可解密内容不伪造源码"/>
                    <TextBlock Text="状态：待实现" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
                </StackPanel></GroupBox>
            </UniformGrid>
        </StackPanel></ScrollViewer></TabItem>
        </TabControl>
    </DockPanel>
</Window>
